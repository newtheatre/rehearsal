# Copy to .env — see docs/development.md. Never commit .env.

# Session seal secret. Any 32+ char string in dev; must MATCH the auth
# service's dev value if you run both locally. Leave the line commented out
# and nuxt-auth-utils generates one into .env on first `bun run dev` — an
# empty value does NOT trigger generation and breaks session sealing.
# Production: worker secret, shared estate-wide — see docs/operations.md.
# NUXT_SESSION_PASSWORD=

# Service token issued by the auth service (stage-door). Leave unset in dev:
# the add-by-email shadow-user path is stubbed locally (Phase 2), and the
# inbound GDPR hooks reject everything, which is the correct dev posture.
NUXT_AUTH_SERVICE_TOKEN=

# Leave unset in dev: emails are logged to the console instead of sent
# (Phase 3 — expiry warnings and digests).
NUXT_RESEND_API_KEY=
NUXT_RESEND_FROM_EMAIL=
