// Standalone config for `wrangler d1 migrations` against the production
// training DB (docs/operations.md#deployments). The build-generated config in
// .output/server resolves its migrations_dir relative to itself and breaks
// when invoked directly — this one points at the source migrations.
//
//   npx wrangler d1 migrations list training --remote -c wrangler.d1.jsonc
//   npx wrangler d1 migrations apply training --remote -c wrangler.d1.jsonc
{
  "name": "rehearsal",
  "compatibility_date": "2025-07-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "training",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_table": "_hub_migrations",
      "migrations_dir": "server/db/migrations/sqlite"
    }
  ]
}
